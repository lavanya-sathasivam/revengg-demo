# Authentication/session settings (upload mode)
# Demo mode is anonymous and read-only. Keep the cookie secure behind HTTPS;
# set to false only for local HTTP testing.
# REVENGG_SESSION_COOKIE_SECURE=true
# REVENGG_SESSION_TTL_SECONDS=28800

# Upload processing limits (upload mode only).
# These are local/test defaults, not approved production limits. Production
# values remain open under OQ-04 in docs/DECISIONS_AND_OPEN_QUESTIONS.md.
# REVENGG_UPLOAD_MAX_BYTES=10485760
# REVENGG_UPLOAD_MAX_PAGES=200
# REVENGG_UPLOAD_MAX_EXTRACTED_CHARS=1000000
# REVENGG_UPLOAD_MAX_PROCESSING_SECONDS=30

# LLM_PROVIDER=gemini | openai | mock
LLM_PROVIDER=mock

# Gemini
GEMINI_API_KEY=
LLM_MODEL=gemini-2.5-flash

# OpenAI
OPENAI_API_KEY=
# LLM_MODEL=gpt-4o-mini
