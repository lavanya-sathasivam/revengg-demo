# Authentication/session settings (upload mode)
# Demo mode is anonymous and read-only. Keep the cookie secure behind HTTPS;
# set to false only for local HTTP testing.
# REVENGG_SESSION_COOKIE_SECURE=true
# REVENGG_SESSION_TTL_SECONDS=28800

# LLM_PROVIDER=gemini | openai | mock
LLM_PROVIDER=mock

# Gemini
GEMINI_API_KEY=
LLM_MODEL=gemini-2.5-flash

# OpenAI
OPENAI_API_KEY=
# LLM_MODEL=gpt-4o-mini
